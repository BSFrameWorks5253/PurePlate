# ==============================================================================
# PurePlate Citizen Food Safety Network — Example Environment Configuration
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# Server Network Configuration
PORT=3000
HTTPS_PORT=3443
HOST=0.0.0.0
NODE_ENV=production

# Security & Authentication Secrets
# Generate a strong 64-character random key for production
JWT_SECRET=your_super_secret_jwt_hmac_signing_key_replace_this_with_random_hex
TOKEN_EXPIRY_DAYS=30

# API Security & Brute-Force Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=15

# Map Provider API Configuration
# Options: carto-dark (recommended high-contrast retina), carto-voyager, osm, mapbox
MAP_TILE_PROVIDER=carto-dark
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
MAP_MAX_ZOOM=20
MAP_DEFAULT_LAT=21.1738
MAP_DEFAULT_LNG=72.8028
MAP_DEFAULT_ZOOM=13

# Optional: Mapbox Access Token (if using Mapbox tiles)
# MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0

# Cloudflare Tunnel & Edge Integration
CLOUDFLARE_TUNNEL_URL=https://philips-quit-marion-activation.trycloudflare.com
SURAT_NODE_ID=SURAT_ATHWA_CENTRAL_01
